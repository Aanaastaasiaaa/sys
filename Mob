package com.example.contactdata

data class Contact(
    var lastName: String = "",
    var firstName: String = "",
    var middleName: String = "",
    var phone: String = ""
) {
    // Сокращённое отображение для главного экрана: "Иванов И. И."
    fun shortName(): String {
        val l = lastName.ifBlank { "—" }
        val f = firstName.firstOrNull()?.let { "$it." } ?: ""
        val m = middleName.firstOrNull()?.let { "$it." } ?: ""
        return "$l $f $m".trim()
    }
}



package com.example.contactdata

import androidx.lifecycle.ViewModel

class ContactViewModel : ViewModel() {

    // Список контактов
    val contacts = mutableListOf<Contact>()

    // Индекс текущего отображаемого контакта
    var currentIndex: Int = 0

    init {
        // Пара контактов для примера — можно убрать
        contacts.add(Contact("Иванов", "Иван", "Иванович", "8 (999) 999-99-99"))
        contacts.add(Contact("Петров", "Пётр", "Петрович", "8 (888) 888-88-88"))
    }

    fun next(): Contact? {
        if (contacts.isEmpty()) return null
        currentIndex = (currentIndex + 1) % contacts.size
        return contacts[currentIndex]
    }

    fun prev(): Contact? {
        if (contacts.isEmpty()) return null
        currentIndex = (currentIndex - 1 + contacts.size) % contacts.size
        return contacts[currentIndex]
    }

    fun current(): Contact? =
        contacts.getOrNull(currentIndex)

    fun add(contact: Contact) {
        contacts.add(contact)
        currentIndex = contacts.size - 1
    }

    fun update(index: Int, contact: Contact) {
        if (index in contacts.indices) {
            contacts[index] = contact
        }
    }
}





