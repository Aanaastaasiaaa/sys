class AirCastle:
    def __init__(self, height, clouds, color):
        self.height = height
        self.clouds = clouds
        self.color = color

    def change_height(self, value):
        self.height = max(0, self.height + value)

    def __add__(self, n):
        self.clouds += n
        self.height += n // 5
        return self

    def __call__(self, transparency):
        return self.height // transparency * self.clouds

    def __str__(self):
        return f"The AirCastle at an altitude of {self.height} meters is {self.color} with {self.clouds} clouds"

    def __eq__(self, other):
        return (self.clouds, self.height, self.color) == (other.clouds, other.height, other.color)

    def __lt__(self, other):
        return (self.clouds, self.height, self.color) < (other.clouds, other.height, other.color)

    def __le__(self, other):
        return self < other or self == other

    def __gt__(self, other):
        return not self <= other

    def __ge__(self, other):
        return not self < other


class PaintedAirCastle(AirCastle):
    def __init__(self, height, clouds, color, pattern):
        super().__init__(height, clouds, color)
        self.pattern = pattern

    def __str__(self):
        return super().__str__() + f", pattern: {self.pattern}"


castle = AirCastle(100, 10, "blue")
print(castle)

castle.change_height(-30)
print(castle)

castle = castle + 10
print(castle)

print(castle(5))

painted = PaintedAirCastle(50, 8, "white", "striped")
print(painted)

print(castle < painted)
