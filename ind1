from collections import Counter

votes = Counter()

while True:
    try:
        name = input()
        votes[name] += 1
    except EOFError:
        break

total = sum(votes.values())
candidates = votes.most_common()

if candidates[0][1] > total / 2:
    print(candidates[0][0])
else:
    print(candidates[0][0])
    print(candidates[1][0])
